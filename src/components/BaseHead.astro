---
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { site } from '../data/site';
interface Props { title: string; description: string; image?: ImageMetadata; noindex?: boolean; article?: boolean; }
const { title, description, image = site.cover, noindex = false, article = false } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="color-scheme" content="dark light" />
<meta name="theme-color" content="#181818" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title={site.name} href="/rss.xml" />
<link rel="canonical" href={canonicalURL} />
<meta name="generator" content={Astro.generator} />
{noindex && <meta name="robots" content="noindex,follow" />}
<title>{title}</title>
<meta name="description" content={description} />
<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image.src, Astro.site)} />
<meta name="twitter:card" content="summary_large_image" />
<script is:inline>
  try {
    document.documentElement.dataset.theme = localStorage.getItem('yun-theme') === 'light' ? 'light' : 'dark';
  } catch { document.documentElement.dataset.theme = 'dark'; }
</script>
