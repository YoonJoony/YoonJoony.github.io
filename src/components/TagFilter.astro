---
// Posts 상단의 전체·Python·Study 등 태그 줄입니다.
// 태그 이름을 여기에 직접 나열하지 않고, 공개 글의 tags를 모아서 만듭니다.
// 칩의 크기·간격은 global.css의 .tag-filter, 클릭 처리는 scripts/posts-browser.ts입니다.
import type { Post } from '../lib/posts';
import { uniqueTags } from '../lib/tags';
import { postsUrl } from '../lib/post-urls';
interface Props { posts: Post[]; }
// flatMap: 글마다 가진 태그 배열을 하나로 합칩니다.
// uniqueTags: 중복을 지웁니다. sort: 표시 이름 순으로 정렬합니다.
const tags = uniqueTags(Astro.props.posts.flatMap((post) => post.tags)).sort((a,b) => a.label.localeCompare(b.label, 'en'));
---
<nav class="tag-filter" aria-label="태그로 글 필터">
  <span class="filter-label">태그</span>
  {/* 빈 태그 값은 전체를 뜻합니다. 일반 링크도 있어 JavaScript 없이 페이지 이동이 가능합니다. */}
  <a href="/posts/" class="tag is-active" data-filter-tag="" aria-current="true">전체</a>
  {tags.map((tag) => <a href={postsUrl('', tag.id)} class="tag" data-filter-tag={tag.id}>{tag.label}</a>)}
</nav>
