---
// 페이지 맨 아래 저작권·GitHub·RSS 링크입니다.
// 이름·GitHub 주소는 data/site.ts, 여백과 구분선은 global.css의 .site-footer에서 바꿉니다.
import { site } from '../data/site';
---
<footer class="site-footer container">
  <span>© {new Date().getFullYear()} {site.name}</span>
  <nav aria-label="외부 링크"><a href={site.github}>GitHub</a><a href="/rss.xml">RSS</a></nav>
</footer>
