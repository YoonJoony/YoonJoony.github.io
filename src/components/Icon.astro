---
// 사진 파일 대신 선으로 그리는 SVG 아이콘입니다.
// 사용하는 곳에서 name="folder"처럼 종류를 고르고, size={24}처럼 크기를 바꿉니다.
// paths의 문자열은 선을 그리는 좌표입니다. 크기 수정에는 이 좌표를 바꿀 필요가 없습니다.
interface Props { name: string; size?: number; }
const { name, size = 20 } = Astro.props;
const paths: Record<string, string> = {
  folder: 'M3 7V5a1 1 0 0 1 1-1h5l2 3h9a1 1 0 0 1 1 1v11H3V7Z',
  chevron: 'm9 5 7 7-7 7',
  code: 'm8 7-5 5 5 5m8-10 5 5-5 5m-3-14-2 18',
  database: 'M20 6c0 2-4 3-8 3S4 8 4 6s4-3 8-3 8 1 8 3Zm0 0v12c0 2-4 3-8 3s-8-1-8-3V6m0 6c0 2 4 3 8 3s8-1 8-3',
  note: 'M14 3H5v18h14V8l-5-5Zm0 0v6h5M8 13h8m-8 4h8',
  moon: 'M20 14A9 9 0 0 1 10 3a9 9 0 1 0 10 11Z',
  sun: 'M12 3V1m0 22v-2M3 12H1m22 0h-2M5 5 3 3m18 18-2-2M5 19l-2 2M21 3l-2 2M16 12a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z',
};
---
{/* currentColor는 주변 글자색을 따릅니다. stroke-width는 선 굵기입니다.
    장식 아이콘은 aria-hidden으로 보조 기기가 중복해서 읽지 않도록 합니다. */}
<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={paths[name] ?? paths.note} /></svg>
