---
// 특정 글을 읽는 페이지입니다. 예: /posts/python-study01/
// 파일명의 [...slug]는 주소의 달라지는 부분을 받아들이는 Astro 문법입니다.
// 왼쪽 목록은 PostsLayout, 오른쪽 글 모양은 PostReader가 담당합니다.
import { getCollection, render } from 'astro:content';
import PostsLayout from '../../layouts/PostsLayout.astro';
import PostReader from '../../components/PostReader.astro';
import { getPosts, legacySlug } from '../../lib/posts';
import { site } from '../../data/site';

// 빌드할 때 만들 글 주소 목록을 반환합니다.
// params.slug는 주소, props는 해당 페이지에 전달할 글 데이터입니다.
export async function getStaticPaths() {
  const posts = await getPosts();
  // legacy는 기존 템플릿 글입니다. 옛 주소로 찾아온 방문자도 계속 읽을 수 있게 보관합니다.
  const legacy = await getCollection('legacy');
  const legacySlugs = new Set(legacy.map(legacySlug));
  for (const post of posts) if (legacySlugs.has(post.slug)) throw new Error('Slug conflicts with an archived URL: ' + post.slug);
  return [
    ...posts.map((post) => ({ params: { slug: post.slug }, props: { entry: post.entry, post, legacy: false } })),
    ...legacy.map((entry) => ({ params: { slug: legacySlug(entry) }, props: { entry, post: null, legacy: true } })),
  ];
}
// Astro.props로 위에서 준비한 데이터를 꺼냅니다.
const { entry, post, legacy } = Astro.props;
// render()는 Markdown 본문을 아래에서 <Content />로 출력할 수 있게 준비합니다.
const { Content } = await render(entry);
// ?.는 값이 있을 때만 접근하고, ??는 값이 없을 때 오른쪽 대체값을 사용합니다.
const slug = post?.slug ?? legacySlug(entry as import('astro:content').CollectionEntry<'legacy'>);
const image = post?.image ?? entry.data.heroImage ?? site.cover;
---
{/* 컴포넌트 안에 넣은 태그는 그 컴포넌트의 <slot /> 자리에 들어갑니다.
    {...entry.data}는 글의 title, description 등 속성을 한 번에 전달합니다. */}
<PostsLayout title={entry.data.title + ' · YUN.LOG'} description={entry.data.description} image={image} slug={slug} folder={post?.folder} tags={post?.tags} legacy={legacy}>
  <PostReader {...entry.data} image={image} tags={post?.tags} folder={post?.folder} categoryLabel={post?.categoryLabel}>
    <Content />
  </PostReader>
</PostsLayout>
