---
// 메인 페이지(/)의 구성 순서를 정하는 파일입니다.
// 읽는 순서: 이 파일 → 각 컴포넌트 → styles/global.css.
// 소개 문구·사진은 data/site.ts, 색·너비·간격은 global.css에서 바꿉니다.
// --- 사이 코드는 빌드할 때 데이터를 준비합니다. 아래 태그들은 화면 구조입니다.
// <ProfileHero />처럼 대문자로 시작하는 태그는 다른 파일에서 가져온 화면 조각입니다.
import { Image } from 'astro:assets';
import potatoIcon from '../assets/potato.png';
import SiteLayout from '../layouts/SiteLayout.astro';
import ProfileHero from '../components/ProfileHero.astro';
import PostCard from '../components/PostCard.astro';
import NewsCard from '../components/NewsCard.astro';
import { getPosts, getNews } from '../lib/posts';
import { site } from '../data/site';
// getPosts()가 초안을 제외하고 최신순으로 정렬합니다. slice(0, 3)은 앞의 3개만 선택합니다.
// 글 수를 바꿀 때는 아래 카드 배치와 global.css의 .recent-grid도 함께 확인하세요.
const posts = (await getPosts()).slice(0, 3);
const news = await getNews();
---
<SiteLayout>
  <main id="main" class="container home-main">
    {/* 1. 상단 소개: 왼쪽 사진 + 오른쪽 소개 문구·관심 분야 */}
    <ProfileHero />
    {/* 2. 최근 글: featured는 왼쪽 큰 카드, compact는 오른쪽 작은 카드입니다.
        map()은 배열의 각 글마다 컴포넌트를 하나씩 만듭니다.
        조건 ? A : B는 글이 있으면 A, 없으면 B(안내 문구)를 보여준다는 뜻입니다. */}
    <section class="recent-section" aria-labelledby="recent-title">
      <h2 id="recent-title" class="section-title recent-title">
        {/* 제목 앞의 장식 아이콘입니다. 표시 크기와 간격은 global.css의 .recent-title에서 조절합니다. */}
        <Image src={potatoIcon} alt="" class="recent-title-icon" width={36} height={36} densities={[1, 2]} format="webp" />
        <span>땃땃한 최신글</span>
      </h2>
      {posts.length ? <div class="recent-grid">
        <PostCard post={posts[0]} variant="featured" />
        <div class="recent-side">{posts.slice(1).map((post) => <PostCard post={post} variant="compact" />)}</div>
      </div> : <p class="empty-message">첫 번째 기록을 준비하고 있습니다.</p>}
    </section>
    {/* 3. 뉴스: 실제 뉴스가 있으면 NewsCard를 반복하고, 없으면 준비 중 화면을 보여줍니다.
        최신 3개를 고르는 기준은 lib/posts.ts의 getNews()에 있습니다. */}
    <section class="news-section" aria-labelledby="news-title">
      <h2 id="news-title" class="section-title">News Research</h2>
      {news.length ? <div class="news-list">{news.map((item) => <NewsCard item={item} />)}</div>
        : <div class="news-card news-empty">
            <Image src={site.cover} alt="" widths={[480, 800]} sizes="(max-width: 700px) 100vw, 50vw" format="webp" />
            <div class="news-copy"><p class="eyebrow">ECONOMY · IT</p><h3>뉴스 리서치를 준비 중입니다</h3><p>경제와 IT의 흐름을 읽고, 생각을 기록합니다.</p><ul class="tags"><li><span class="tag">경제</span></li><li><span class="tag">IT</span></li></ul></div>
          </div>}
    </section>
  </main>
</SiteLayout>
