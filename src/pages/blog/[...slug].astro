---
import { getCollection } from 'astro:content';
import { legacySlug } from '../../lib/posts';
export async function getStaticPaths() {
  return (await getCollection('legacy')).map((post) => ({ params: { slug: post.id }, props: { destination: '/posts/' + legacySlug(post) + '/' } }));
}
return Astro.redirect(Astro.props.destination, 301);
---
