---
import SiteLayout from './SiteLayout.astro';
import TagFilter from '../components/TagFilter.astro';
import CategoryNode from '../components/CategoryNode.astro';
import Icon from '../components/Icon.astro';
import { getPosts } from '../lib/posts';
import { buildPostTree } from '../lib/post-tree';
import { postsUrl } from '../lib/post-urls';
import type { ImageMetadata } from 'astro';
interface Props { title?: string; description?: string; image?: ImageMetadata; slug?: string; folder?: string; tags?: string[]; legacy?: boolean; }
const { title = 'Posts · YUN.LOG', description, image, slug = '', folder = '', tags = [], legacy = false } = Astro.props;
const posts = await getPosts();
const tree = buildPostTree(posts);
const postMap = new Map(posts.map((post) => [post.slug, post]));
---
<SiteLayout title={title} description={description} image={image} noindex={legacy} article={!!slug} class="posts-page">
  <main id="main" class="container posts-main" data-posts-browser data-initial-slug={slug} data-initial-folder={folder} data-initial-tags={JSON.stringify(tags)} data-initial-title={title}>
    <h1 class="sr-only">Posts 글 탐색</h1>
    <TagFilter posts={posts} />
    <div class:list={['posts-workspace', { 'has-article': !!slug }]}>
      <aside class="posts-sidebar" aria-label="카테고리와 글 목록" tabindex="-1">
        {tree.map((node) => <CategoryNode node={node} posts={postMap} selectedSlug={slug} selectedFolder={folder} />)}
        <p class="filter-empty" data-filter-empty hidden>이 폴더에는 선택한 태그의 글이 없습니다.</p>
        <p class="sr-only" role="status" data-filter-status></p>
      </aside>
      <section class="reader-pane" aria-label="선택한 글" tabindex="-1">
        <div class="reader-selection" data-reader-selection hidden={!slug}>
          <a class="mobile-back" href={postsUrl(folder)} data-reader-back>목록으로 돌아가기</a>
          {legacy && <p class="archive-label">이전 블로그에 작성된 글입니다.</p>}
          <slot />
        </div>
        <div class="reader-empty" data-reader-empty hidden={!!slug}>
          <Icon name="note" size={36} />
          <h2>어떤 기록부터 읽어볼까요?</h2>
          <p>왼쪽 카테고리를 펼쳐 읽을 글을 선택하세요.<br />태그로 관심 있는 주제를 찾아볼 수도 있어요.</p>
        </div>
      </section>
    </div>
  </main>
  <script>
    import '../scripts/posts-browser';
  </script>
</SiteLayout>
